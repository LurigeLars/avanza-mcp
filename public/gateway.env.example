# Cloudflare Access application settings.
# Copy to public/gateway.env and keep the real file out of Git.
ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
ACCESS_AUD=replace-with-access-application-audience
ACCESS_ALLOWED_EMAILS=you@example.com

# Optional hardening / tuning.
RATE_PER_MIN=120
MAX_BODY_BYTES=2097152

# Optional: override the gateway tool surface.
# Use @authenticated for the reviewed public + authenticated read-only Avanza surface.
# ALLOWED_TOOLS=@authenticated
# Or provide an explicit comma-separated list:
# ALLOWED_TOOLS=search_instruments,get_stock_quote
